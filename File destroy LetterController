public function destroy(Letter $letter)
    {
        if ($letter->reply_to_id !== null) {
            return redirect()->route('letters.index')->with('error', 'Surat balasan tidak boleh dihapus secara mandiri.');
        }

        $letterName = $letter->name;

        Activity::create([
            'user_id' => Auth::id(),
            'description' => 'telah menghapus surat',
            'subject_name' => $letterName,
            'type' => 'Surat'
        ]);

        if (Storage::disk('public')->exists($letter->file_path)) { 
            Storage::disk('public')->delete($letter->file_path); 
        }
        $letter->delete();

        return redirect()->route('letters.index')->with('success', 'Surat berhasil dihapus!');
    }

